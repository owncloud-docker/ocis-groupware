{
  "name": "groupware",
  "version": "0.0.0",
  "private": true,
  "description": "Calendar and contacts application for ownCloud Web",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode development",
    "lint": "eslint .",
    "check:types": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run check:types && npm run l10n:check && npm run test && npm run build",
    "test:e2e": "playwright test",
    "l10n:extract": "node scripts/l10n.mjs extract",
    "l10n:compile": "node scripts/l10n.mjs compile",
    "l10n:check": "node scripts/l10n.mjs check"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/luxon3": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@fullcalendar/vue3": "6.1.22",
    "@ownclouders/web-client": "12.5.0",
    "@ownclouders/web-pkg": "12.5.0"
  },
  "devDependencies": {
    "@ownclouders/eslint-config": "12.5.0",
    "@ownclouders/extension-sdk": "12.5.0",
    "@ownclouders/tsconfig": "0.0.7",
    "@playwright/test": "1.64.1",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "happy-dom": "21.0.4",
    "luxon": "3.7.2",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13",
    "vue3-gettext": "4.0.1"
  }
}
